	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA15HIZxT82PmLr3E4DbwNa8hb89uKnwXjTste9fTHqr
[push]
	default = current
[core]
	autoCRLF = false
[pager]
        branch = cat
        diff = delta
        log = delta
        reflog = delta
        show = delta

[alias]
        br = branch
        ch = checkout
        gr = log --graph --oneline
        st = status
        cm = commit
        df = diff
[commit]
	template = ~/dotfiles/commit_template
	gpgsign = true
[init]
	defaultBranch = "main"

[interactive]
    diffFilter = delta --color-only

[delta]
    features = side-by-side line-numbers decorations
    whitespace-error-style = 22 reverse

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
