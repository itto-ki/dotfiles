#!/bin/bash
# agy で文章を校正する。依頼文は ../agy-proof/prompt.md に固定し、毎回作り直さない。
#
#   agy-proof <入力ファイル> [--audience <読み手>] [--note <追加の注文>]
#   agy-proof --collect <作業ディレクトリ>
#
# 校正の結果は作業ディレクトリの out.md に出し、入力との差分を表示する。
# sandbox の中では agy の通信が拒否されるので、Claude からは claude-run で呼ぶ:
#   ~/.local/bin/claude-run --cwd <dir> 'agy-proof <入力ファイル> --audience <読み手>'
# それでも agy が動かないとき（Antigravity のログインが切れているなど）は exit 3 で終わり、
# ユーザーに頼む ! の 1 行を出す。ユーザーが実行したら --collect で結果を読む。
set -uo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
prompt_file="$here/../agy-proof/prompt.md"
timeout=600s

show_result() { # show_result <作業ディレクトリ>
  local dir=$1
  if [ ! -s "$dir/out.md" ]; then
    echo "agy-proof: $dir/out.md が空。agy の出力（err.txt の末尾）:" >&2
    tail -n 5 "$dir/err.txt" >&2 2>/dev/null
    return 1
  fi
  echo "校正の結果: $dir/out.md"
  echo "--- 差分（入力 → 結果）"
  diff -u "$dir/input.md" "$dir/out.md" | tail -n +3
  return 0
}

if [ "${1:-}" = "--collect" ]; then
  [ -d "${2:-}" ] || { echo "使い方: agy-proof --collect <作業ディレクトリ>" >&2; exit 2; }
  show_result "$2"
  exit $?
fi

input=${1:-}
[ -f "$input" ] || { echo "使い方: agy-proof <入力ファイル> [--audience <読み手>] [--note <追加の注文>]" >&2; exit 2; }
shift
audience="" note=""
while [ $# -gt 0 ]; do
  case $1 in
    --audience) audience=${2:-}; shift 2 ;;
    --note) note=${2:-}; shift 2 ;;
    *) echo "agy-proof: 知らない引数: $1" >&2; exit 2 ;;
  esac
done
command -v agy >/dev/null || { echo "agy-proof: agy が PATH に無い（~/.local/bin/agy を入れる）" >&2; exit 2; }

dir=$(mktemp -d "${TMPDIR:-/tmp}/agy-proof.XXXXXX")
cp "$input" "$dir/input.md"
{
  cat "$prompt_file"
  [ -n "$audience" ] && printf -- '- 読み手: %s\n' "$audience"
  [ -n "$note" ] && printf -- '- 追加の注文: %s\n' "$note"
  printf '\n--- 校正する文章 ---\n\n'
  cat "$dir/input.md"
} > "$dir/request.md"
cat > "$dir/run.sh" <<EOF
#!/bin/bash
cd "$dir" && agy -p "\$(cat request.md)" --print-timeout $timeout > out.md 2> err.txt
echo "agy exit=\$?"
EOF

bash "$dir/run.sh" >/dev/null
if show_result "$dir" 2>/dev/null; then
  exit 0
fi
echo "agy-proof: agy を実行できなかった。理由（err.txt から）:" >&2
grep -iE 'denied|not logged|authentication|timed out|error:' "$dir/err.txt" 2>/dev/null | grep -v 'logging before' | tail -n 3 >&2
echo "Claude から sandbox の中で呼んだなら、claude-run で呼び直す:" >&2
echo "~/.local/bin/claude-run --cwd $dir 'bash run.sh'" >&2
echo "claude-run でも失敗するなら、ユーザーに次の 1 行を頼む:" >&2
echo "! bash $dir/run.sh" >&2
echo "実行されたら: agy-proof --collect $dir" >&2
exit 3
