#!/usr/bin/env python3
"""Claude Code の使い方の指標を、直近の期間とその前の同じ長さの期間で比べる。

    claude-usage-report [日数（既定 7）] [--json]

~/.claude/projects 以下のトランスクリプトを読むだけで、何も書き換えない。
ルールを足したら、対応する指標が減ったかをこれで確かめる。減らなければルールを一段強くする
（メモリ → スクリプト → フック）。
"""
import collections
import datetime as dt
import json
import re
import sys
import unicodedata
from pathlib import Path

ROOT = Path.home() / ".claude/projects"
JAPANESE = re.compile(r"[぀-ヿ㐀-鿿ｦ-ﾟ]")
LATIN = re.compile(r"[A-Za-z]")
PROMPT_SIGNS = {
    "依頼: 催促（続けて・止まってる）": re.compile(r"^(続けて|Continue where you left off|止まってる|まだ.*(続いて|やって))"),
    "依頼: ユーザーが代わりに実行（実行しました）": re.compile(r"^(コマンドを)?実行し(ました|た)"),
    "依頼: claude-run を促す": re.compile(r"claude-run|あなたが実行"),
    "依頼: 日本語を求める": re.compile(r"日本語で(話|しゃべ|会話|書)"),
    "依頼: 長い・読みづらい": re.compile(r"長い|長すぎ|長ったらしい|読みづら|読めない|わかりづら|分かりづら|簡潔に"),
    "依頼: 反映されていない": re.compile(r"入れ替わってな|入っていない|本当に最新|直ってない|変わってない|起動してない"),
}
SKIP_PROMPT = ("<", "Caveat:", "This session is being continued", "[Request interrupted",
               "You generate concise git branch names", "Act as the ")


def strip_noise(text):
    text = re.sub(r"```.*?```", " ", text, flags=re.DOTALL)
    text = re.sub(r"`[^`\n]*`|https?://\S+|(?<![\w])[~/][\w./@%+=:-]+", " ", text)
    return text


def is_english(text):
    text = strip_noise(text)
    japanese = len(JAPANESE.findall(text))
    total = japanese + len(LATIN.findall(text))
    return total >= 150 and japanese / total < 0.2


def parse_time(value):
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    days = int(args[0]) if args else 7
    now = dt.datetime.now(dt.timezone.utc).timestamp()
    span = days * 86400
    windows = {"前": (now - 2 * span, now - span), "直近": (now - span, now)}
    counts = {name: collections.Counter() for name in windows}

    def window_of(stamp):
        for name, (start, end) in windows.items():
            if stamp is not None and start <= stamp < end:
                return name
        return None

    for path in ROOT.rglob("*.jsonl"):
        if path.stat().st_mtime < now - 2 * span or "t3code-claude-title" in str(path):
            continue
        is_sub = "subagents" in path.parts
        tools, max_context, first, last = {}, collections.Counter(), None, None
        for line in open(path, encoding="utf-8", errors="replace"):
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if not isinstance(entry, dict):
                continue
            stamp = parse_time(entry.get("timestamp"))
            name = window_of(stamp)
            if stamp:
                first, last = first or stamp, stamp
            kind = entry.get("type")
            message = entry.get("message") or {}
            content = message.get("content")
            if name is None or kind not in ("assistant", "user"):
                continue
            c = counts[name]
            if kind == "assistant":
                usage = message.get("usage") or {}
                context = sum(usage.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
                max_context[name] = max(max_context[name], context)
                for block in content or []:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") == "tool_use":
                        c["ツール呼び出し"] += 1
                        tools[block.get("id")] = block.get("name")
                        tool_input = block.get("input") or {}
                        if block.get("name") == "Agent" and tool_input.get("run_in_background") is not False:
                            c["バックグラウンドの Agent"] += 1
                    elif block.get("type") == "text" and not is_sub and is_english(block.get("text", "")):
                        c["英語の返答"] += 1
                continue
            if isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
                for block in content:
                    if not isinstance(block, dict) or block.get("type") != "tool_result" or not block.get("is_error"):
                        continue
                    c["ツールのエラー"] += 1
                    result = block.get("content")
                    text = result if isinstance(result, str) else json.dumps(result, ensure_ascii=False)
                    if "adapter has no active turn" in text:
                        c["エラー: ターン外のツール呼び出し"] += 1
                    if "pseudo-auto:" in text:
                        c["フックが止めた呼び出し"] += 1
                continue
            if is_sub or entry.get("isMeta"):
                continue
            text = content if isinstance(content, str) else "\n".join(
                b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text")
            text = text.strip()
            if not text or text.startswith(SKIP_PROMPT):
                continue
            c["ユーザーの依頼"] += 1
            for sign, pattern in PROMPT_SIGNS.items():
                if pattern.search(text):
                    c[sign] += 1
        if is_sub:
            continue
        for name, context in max_context.items():
            counts[name]["セッション"] += 1
            if context > 400_000:
                counts[name]["コンテキスト 40 万超のセッション"] += 1
        name = window_of(last)
        if name and first and last - first > 86400:
            counts[name]["24 時間をまたぐセッション"] += 1

    for c in counts.values():
        c["ツールのエラー率(%)"] = round(100 * c["ツールのエラー"] / c["ツール呼び出し"], 1) if c["ツール呼び出し"] else 0
    if "--json" in sys.argv:
        print(json.dumps({"days": days, **{k: dict(v) for k, v in counts.items()}}, ensure_ascii=False, indent=1))
        return
    keys = ["セッション", "ユーザーの依頼", "ツール呼び出し", "ツールのエラー", "ツールのエラー率(%)",
            "エラー: ターン外のツール呼び出し", "フックが止めた呼び出し", "バックグラウンドの Agent", "英語の返答",
            "コンテキスト 40 万超のセッション", "24 時間をまたぐセッション", *PROMPT_SIGNS]
    def pad(text, width, right=False):
        gap = " " * max(0, width - sum(2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in str(text)))
        return gap + str(text) if right else str(text) + gap

    width = max(len(k) * 2 for k in keys) + 2
    print(pad("指標", width) + pad(f"前の{days}日", 12, True) + pad(f"直近{days}日", 12, True))
    for key in keys:
        before, after = counts["前"][key], counts["直近"][key]
        mark = "  ↑" if after > before else ("  ↓" if after < before else "")
        print(pad(key, width) + pad(before, 12, True) + pad(after, 12, True) + mark)


if __name__ == "__main__":
    main()
