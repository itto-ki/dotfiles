#!/usr/bin/env python3
"""Run one shell command after the user's existing PreToolUse approval check.

This is an explicitly invoked external command, not a replacement for Bash.
Directory changes apply only to this invocation. It does not inspect the
contents of external programs or remove Claude Code's managed tool denies.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cwd", help="Working directory for this invocation only")
    parser.add_argument("--check", action="store_true", help="Check without executing")
    parser.add_argument("command", help="One quoted Bash command string")
    args = parser.parse_args()
    if not args.command.strip():
        parser.error("command must not be empty")
    try:
        directory = Path(args.cwd).expanduser().resolve(strict=True) if args.cwd else Path.cwd()
        if not directory.is_dir():
            raise ValueError("working directory is not a directory")
        hook = Path.home() / ".claude/hooks/pseudo-auto.py"
        response = subprocess.run(
            [sys.executable, str(hook)],
            input=json.dumps({
                "hook_event_name": "PreToolUse",
                "tool_name": "Bash",
                "tool_input": {"command": args.command},
                "cwd": str(directory),
            }),
            capture_output=True, text=True, timeout=5, check=True,
        )
        decision = json.loads(response.stdout)["hookSpecificOutput"]
        if decision.get("hookEventName") != "PreToolUse":
            raise ValueError("unexpected hook response")
        if decision.get("permissionDecision") != "allow":
            print("claude-run: refused: " + decision.get("permissionDecisionReason", "not approved"), file=sys.stderr)
            return 126
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as exc:
        print("claude-run: approval check failed: " + str(exc), file=sys.stderr)
        return 126
    if args.check:
        print("claude-run: allowed (not executed)")
        return 0
    try:
        os.chdir(directory)
        os.execv("/bin/bash", ["bash", "-c", args.command])
    except OSError as exc:
        print("claude-run: execution failed: " + str(exc), file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
